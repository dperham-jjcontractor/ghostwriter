# Ghostwriter settings. Lives at /home/root/.ghostwriter.toml on the tablet.
# Precedence: these values < GHOSTWRITER_* environment variables < command-line flags.
# After changing this file: systemctl restart ghostwriter

# Which model reads the page. gpt-6-sol reads handwriting well at about a cent
# per tap; gpt-6-luna is much cheaper and worth trying once things work.
model = "gpt-6-sol"

# Which prompt to use: a bundled name, or a file path. coach.json is the notes coach.
# A copy at /home/root/ghostwriter/prompts/coach.json overrides the bundled one and
# is picked up on the next tap, no restart needed.
prompt = "coach.json"

# Where a finger tap starts a run. TC = top centre of the screen (the brain icon on the
# "Lined medium + coach" page template marks it). Also BC (bottom centre) or the corners
# UR, UL, LR, LL; the corners collide with the tablet's close button and toolbar.
trigger_corner = "TC"

# The API key normally lives in /home/root/ghostwriter/.env as OPENAI_API_KEY=...
# It can be set here instead:
# engine_api_key = "sk-..."

# How hard the model thinks before answering: "none" is fastest and is required for
# gpt-6 models to use tools on this endpoint; "low" or "medium" for slower, deeper replies.
openai_reasoning_effort = "none"

# Where the reply goes. true: the coach turns to the next page (a new one at the end
# of the notebook) and types there; swipe right to get back to the notes. false: the
# reply is typed on the same page, which can land on top of handwriting.
reply_on_new_page = true

# Memory: after each reply the coach updates a short file of what it has learned about her
# (/home/root/ghostwriter/memory.txt) and uses it on every later page. One extra API call
# per tap. See deploy\show-memory.ps1 to read, edit or reset it.
memory_enabled = true
# Model for that update; empty = the same as "model". Cap on the memory size in characters.
memory_model = ""
memory_max_chars = 1500

# Drawing. false lets the coach draw pictures with the pen when asked (they go on the
# reply page, never on the notes). true makes it type only.
no_svg = false

# info is enough day to day. debug logs are large and include request details.
log_level = "info"

# The settings web page stays off: it has no password, and it is not needed.
web_server = false
